<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ─── Permissions ──────────────────────────────────────────────────────── -->
    <!-- Internet: required for audio streaming, prayer times API, tafseer download -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Audio playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- P3-46: DownloadForegroundService — keeps the process from being
         frozen/killed by the OS while backgrounded during an active download. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- P3-47: the persistent "next prayer" card runs as a real foreground
         service (flutter_local_notifications) so it can't be swiped away and
         survives the app being closed — the owner asked for it to stay put
         like Salatuk's. specialUse is the honest FGS type for a standing
         countdown card that isn't one of the predefined categories. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- «مشغّل تلاوة القرآن» scans the phone's own audio: READ_MEDIA_AUDIO on
         Android 13+, the storage permission below it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Exact alarm scheduling for prayer time notifications -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Boot receiver to reschedule alarms after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Full Screen Intent (Adhan) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD"/>
    <!-- Draw-over-other-apps: a fallback path for the Adhan alert to surface
         over the lock screen on Android 14+/16 OEM skins that throttle a
         background full-screen-intent launch. The primary path is the
         fullScreenIntent notification (category=alarm, max importance) that
         launches **AdhanActivity** — which is the alert screen, declares
         showWhenLocked + turnScreenOn, and lives in its own task.

         This note used to say the intent launched MainActivity, and
         MainActivity carried those two flags to match. That was the bug the
         owner hit twice: the whole app opening over the lock screen, and the
         adhan "opening on the settings screen instead of the video". Only
         AdhanActivity bypasses the keyguard now. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    
    <!-- The rebuilt Adhan fires as a real alarm: AdhanScheduler arms it with
         AlarmManager.setAlarmClock (SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM,
         declared above), AdhanAlarmReceiver wakes on it, and AdhanService
         plays it as a mediaPlayback foreground service while holding a
         partial wake lock. TURN_SCREEN_ON is what lets AdhanActivity wake a
         dark display on Android 10+, the same way a clock app does. -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON"/>

    <!-- Battery optimizations exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    
    <!-- Location (Prayer Times) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="@string/app_name"
        android:name=".RafeeqApplication"
        android:icon="@mipmap/ic_launcher">
        <!-- WorkManager initialises on demand, not at every process start.

             Measured on emulator-5554: 65 slow class verifications totalling
             9,724 ms before the app did anything, 45 of them androidx.work,
             against Android's 10-second process-startup limit — twice
             producing «ANR … Process failed to complete startup», both times
             on a process woken by a scheduled-notification broadcast that had
             no use for WorkManager at all.

             Removing only the WorkManagerInitializer entry, not the whole
             InitializationProvider: ProcessLifecycleInitializer and
             ProfileInstallerInitializer are cheap and other things rely on
             them. `RafeeqApplication` supplies the Configuration, which is
             what makes on-demand initialisation legal. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            singleTask, not singleTop.

            `background_downloader`'s own docs say it plainly: "For
            notification callbacks, make sure your AndroidManifest includes
            android:launchMode="singleTask" to ensure proper behavior when a
            notification is tapped." It shipped as singleTop, and MEASURED on
            emulator-5554 the consequence was exactly that — a real ruqyah
            download was started, the app was left on Home, the shade was
            pulled down and its «تحميل ملفات الرقية الصوتية» notification was
            tapped, and the app came forward **on Home**. The tap callback was
            registered, the payload was right, `flutter analyze` was clean and
            197 tests passed; the routing simply never ran.

            This is trap #27 in one line: a green test run is not the feature
            working, and the only proof for a notification is tapping a real
            one.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ─── Adhan (rebuilt, native alarm pipeline) ──────────────────────
             AdhanActivity is the "ringing phone" screen. It lives in its own
             task (taskAffinity + excludeFromRecents) so firing it never
             disturbs whatever the user was doing inside the app, and it is
             showWhenLocked + turnScreenOn so it draws over the lock screen
             and wakes the display without an unlock — exactly like an alarm
             clock or an incoming call. It runs the `adhanMain` Dart
             entrypoint, not the whole app.
             `android:theme` is the plain Normal theme, not LaunchTheme: the
             alert paints its own full-bleed background and must not flash the
             app's splash first. -->
        <activity
            android:name=".adhan.AdhanActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.tito.rafeeq_aldarb.adhan"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"/>

        <!-- Receives the exact alarm. Not exported: only AlarmManager, acting
             on our own PendingIntent, ever delivers to it. -->
        <!-- The next-prayer card: re-posted when dismissed, rolled over at the
             prayer's time, and restored after a reboot or an update. -->
        <receiver
            android:name=".PrayerCardReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name=".adhan.AdhanAlarmReceiver"
            android:exported="false"
            android:directBootAware="true"/>

        <!-- Re-arms the persisted schedule after a reboot / app update /
             clock change, since AlarmManager forgets everything then. -->
        <receiver
            android:name=".adhan.AdhanBootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Holds the firing adhan: the MediaPlayer, the alert notification
             (with its real Stop/Mute actions) and the wake lock. Started from
             the exact-alarm broadcast, which is Android's own exemption for
             starting a foreground service from the background. -->
        <service
            android:name=".adhan.AdhanService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- Notification receiver for boot-completed rescheduling -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>

        <!-- P3-46: real foreground service, not a cosmetic notification —
             see DownloadForegroundService's own doc comment for why this
             exists (protecting the process from being frozen/killed by the
             OS while a real download is running in the background). -->
        <!-- Whole-surah downloads run as WorkManager foreground work so they
             keep going with the app in the background (DownloadEngine,
             Config.runInForeground). Android 14 refuses to start that service
             without its declared type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- P3-47: flutter_local_notifications' own foreground service, used
             to keep the persistent next-prayer card non-dismissible and
             alive while the app is closed. -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent next-prayer countdown card"/>
        </service>

        <!-- just_audio_background components -->
        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <service android:name="com.ryanheise.audioservice.AudioService"
                 android:foregroundServiceType="mediaPlayback"
                 android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Generic FileProvider for handing app-private files to other
             components as content:// URIs. The Adhan no longer needs it (the
             rebuilt native player opens an imported MP3 straight from its
             path, in this app own process), so nothing uses it today; it is
             kept declared because it is plain, inert plumbing that the next
             feature to share a private file will want. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
