# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
google-services.json
serviceAccountKey.json

# --- Scratch / research artifacts ---
ksu_home.html
quran_android_resp.html
page1_test.png
*_test.png
analyze*.txt
gradle_err.txt

# --- Pipeline caches & logs (large, regenerable) ---
scripts/quran_com_coords.sql
scripts/sql_sample.sql
scripts/*.log
scripts/*.err
scripts/temp_phase1/
scripts/pipeline_temp/
scripts/pipeline_zips/

# --- Flutter/Dart build output ---
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml

# --- Android ---
android/.gradle/
.gradle/
local.properties

# --- OS ---
.DS_Store
Thumbs.db

# Mushaf SVG staging (downloaded, uploaded to R2, regenerable)
scripts/mushaf_build/

# Toolchain check output (regenerated by scripts/check.ps1)
scripts/_check_output.txt

# P2-4b: built Shamela text editions - regenerable (scripts/build_book_text.py),
# hosted on tito423/rafeeq-api, not carried in this repo (same as hadith.zip).
scripts/book_text_build/
scripts/adhan_video_build/
scripts/__pycache__/
scripts/batch_summary.jsonl
scripts/book_categories.jsonl
scripts/catalog_entries_generated.dart
scripts/compressed_sizes.jsonl

# Release APKs staged for upload — the artifact lives on the GitHub release,
# never in the repo (a 240 MB binary per version would bloat it permanently).
RafeeqAlDarb-*.apk

# The Musnad Ahmad page cache: ~23k raw Shamela pages, several hundred MB,
# regenerable with scripts/fetch_musnad_ahmad_arnaut.py. The parsed result
# (musnad_ahmad_arnaut.json) is what the build actually reads.
scripts/musnad_ahmad_arnaut_pages.jsonl
scripts/sunan_darimi_asad_pages.jsonl
# The two phase-2 encyclopaedias fetched with fetch_shamela_pages.py (71 MB
# and 76 MB, 2026-09-23). Regenerable with that script; the built book on
# the bucket is what the app reads.
scripts/shamela_raw/tahdhib_al_kamal.jsonl
scripts/shamela_raw/lisan_al_arab.jsonl
scripts/mushaf_pdf_build/
scripts/mushaf_fit_build/

# HadeethEnc crawl output: regenerable by scripts/hadeethenc_crawl.py, and it
# grows to tens of MB. The survey and status reports stay - they are the
# measurement, and they are small.
hadeethenc.db
hadeethenc.db-journal
prayer_fixture_progress.jsonl

code_health.txt

# Signing material — the real keystore lives OUTSIDE this repo
# (../Rafeeq-Keys). These rules are a second line of defence.
*.jks
*.keystore
key.properties
lineage.bin
KEYSTORE-PASSWORD.txt

db_type_audit.txt

content_verification.txt

# Release APKs are attached to a GitHub release, never committed:
# one of them is 236 MB, which is over GitHub's 100 MB file limit.
dist/*.apk

# The compatibility matrix writes screenshots and a report; the report is
# useful history, the 84 screenshots are not.
scripts/compat_out/*/
scripts/compat_out/run.log
scripts/compat_out/run*.log

# Regenerable intermediates: strip_editor_apparatus.py rebuilds these from
# the bucket in one command, and 39 MB of book copies rode into the history
# once before anyone looked.
scripts/_stripped/

# Regenerated in one command by build_azkar_from_adhkar.py, and 1.3 MB of it
# re-enters the history on every run. The REPORTS beside it are kept: they are
# cited as evidence in CONTENT-LICENSES.md.
scripts/_azkar_adhkar.json

# Files attached to a Codex task are user input, not repository content.
.codex-remote-attachments/

# strip_named_notes.py writes the cleaned books here before uploading; the
# report stays in git, the books are on R2.
scripts/strip_named_notes_out/*.json

# measure_quran_asr.py downloads recitations and writes its report here.
scripts/asr_probe/
scripts/_geonames/
scripts/shamela_raw/irab_daas_equran.jsonl
