scripts/book_text_build/
scripts/adhan_video_build/
scripts/__pycache__/
scripts/batch_summary.jsonl
scripts/book_categories.jsonl
scripts/catalog_entries_generated.dart
scripts/compressed_sizes.jsonl

# Release APKs staged for upload — the artifact lives on the GitHub release,
# never in the repo (a 240 MB binary per version would bloat it permanently).
RafeeqAlDarb-*.apk

# The Musnad Ahmad page cache: ~23k raw Shamela pages, several hundred MB,
# regenerable with scripts/fetch_musnad_ahmad_arnaut.py. The parsed result
# (musnad_ahmad_arnaut.json) is what the build actually reads.
scripts/musnad_ahmad_arnaut_pages.jsonl
scripts/sunan_darimi_asad_pages.jsonl
scripts/mushaf_pdf_build/
scripts/mushaf_fit_build/

# HadeethEnc crawl output: regenerable by scripts/hadeethenc_crawl.py, and it
# grows to tens of MB. The survey and status reports stay - they are the
# measurement, and they are small.
hadeethenc.db
hadeethenc.db-journal
prayer_fixture_progress.jsonl

code_health.txt

# Signing material — the real keystore lives OUTSIDE this repo
