# Mushaf SVG staging (downloaded, uploaded to R2, regenerable)
scripts/mushaf_build/

# Toolchain check output (regenerated by scripts/check.ps1)
scripts/_check_output.txt

# P2-4b: built Shamela text editions - regenerable (scripts/build_book_text.py),
